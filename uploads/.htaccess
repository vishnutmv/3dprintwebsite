Options -Indexes
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar
  RemoveType .php .phtml .phar
</IfModule>
# Product media is public. Allow any storefront origin so preview deployments
# (which get a new *.vercel.app URL) can load GLB models and images.
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Vary "Origin"
</IfModule>
