Options -Indexes
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar
  RemoveType .php .phtml .phar
</IfModule>
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "https://3dprintwebsite-tau.vercel.app"
  Header always set Vary "Origin"
</IfModule>
