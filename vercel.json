{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/api/?$", "dest": "https://st89310.ispot.cc/api/" },
    { "src": "^/api/(.*)$", "dest": "https://st89310.ispot.cc/api/$1" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/(?:shop|cart|checkout|account|rewards|terms|privacy)/?$", "dest": "/index.html" },
    { "src": "^/product/[^/]+/?$", "dest": "/index.html" },
    { "src": "^/order/[^/]+/?$", "dest": "/index.html" },
    { "src": "^/reward/[^/]+/?$", "dest": "/index.html" },
    { "src": "^/admin(?:/.*)?$", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/404.html", "status": 404 }
  ]
}
